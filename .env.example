# Get free credentials at https://developer.adzuna.com/ (Register -> create an app)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: store snapshots in Supabase instead of a local file.
# SNAPSHOT_SECRET must match the write secret stored in the database
# (adzuna_private.config) — see README "Deployment".
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SNAPSHOT_SECRET=

# Countries to collect a daily snapshot for (comma-separated, live mode only)
# SNAPSHOT_COUNTRIES=gb

# Optional overrides
# PORT=3000
# Keyword(s) used to detect "AI" jobs. Passed as Adzuna's `what` parameter
# (all words must appear). Default: AI
# ADZUNA_AI_QUERY=AI
